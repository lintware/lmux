<?xml version="1.0" encoding="UTF-8"?>
<!--
  lmuxd: the lmux daemon as a launchd agent on macOS (the counterpart of
  lmuxd.service on Linux). install-remote.sh fills in @HOME@ and @PATH@ and
  installs it to ~/Library/LaunchAgents/dev.lmux.lmuxd.plist.

  KeepAlive restarts the daemon if it exits. AbandonProcessGroup leaves the
  tmux server running when the daemon stops or restarts (as KillMode=process
  does under systemd), so terminals survive an update.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.lmux.lmuxd</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/lmux</string>
    <string>server</string>
    <string>--tmux-socket</string>
    <string>lmux</string>
    <string>--ws-addr</string>
    <string>127.0.0.1:7878</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>RUST_LOG</key>
    <string>info</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>@HOME@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@HOME@/.local/state/lmux/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.local/state/lmux/daemon.log</string>
</dict>
</plist>
