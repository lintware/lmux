# lmuxd — the lmux daemon as a systemd --user service.
#
# Install:
#   install -Dm644 deploy/lmuxd.service ~/.config/systemd/user/lmuxd.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now lmuxd
#
# The daemon keeps running across SSH disconnects (user lingering is on) and owns
# the private tmux server and the app websocket. Its unix socket is mode 0600 in
# the state directory; nothing is exposed on the network except the loopback
# websocket the app reaches over an SSH tunnel.

[Unit]
Description=lmux daemon (terminal + browser workspaces)
Documentation=file:///%h/lmux/PLAN.md
After=default.target

[Service]
Type=simple
# `lmux` lives in ~/.local/bin, which is also on the login PATH, so the Claude
# hooks (`lmux hooks claude …`) find the same binary inside panes.
ExecStart=%h/.local/bin/lmux server --tmux-socket lmux --ws-addr 127.0.0.1:7878
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
# The tmux server and windows must outlive the daemon, so let tmux daemonise
# normally; killing lmuxd only drops the control client.
KillMode=process
TimeoutStopSec=10

[Install]
WantedBy=default.target
