# lmux-gateway: the always-on phone gateway as a systemd --user service.
#
# Serves this server's sessions, and those of the servers listed in
# ~/.config/lmux/gateway.env, to a phone through a Cloudflare Quick Tunnel.
# The laptop app asks it for pairing codes over SSH (`lmux share-code`).
# Installed by deploy/install-gateway.sh.
#
# When cloudflared exits the share starts a new tunnel itself, writes the new
# address to ~/.local/state/lmux/share.json and tells connected phones. Paired
# phones are kept in ~/.local/state/lmux/share-sessions.json across restarts.
# It exits (and systemd restarts it) only when the tunnel cannot be started
# again. On a tailnet it also listens at <tailnet IP>:7871.

[Unit]
Description=lmux phone gateway (Cloudflare Quick Tunnel)
After=network-online.target lmuxd.service
Wants=network-online.target

[Service]
Type=simple
# LMUX_GATEWAY_ARGS holds the --server flags and --allow-typing.
EnvironmentFile=-%h/.config/lmux/gateway.env
ExecStart=/bin/sh -c 'exec "$HOME/.local/bin/lmux" share --service $LMUX_GATEWAY_ARGS'
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
